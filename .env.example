# Ollama on the Windows host, reached from Docker Desktop
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
POSTGRES_PASSWORD=learnloop_local
# Optional OIDC login alongside local accounts
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PUBLIC_URL=http://localhost:4318
# Local development only: skip signup/login and use an isolated demo learner.
# Set to false before exposing the app through a public URL.
DEV_AUTH_BYPASS=true
