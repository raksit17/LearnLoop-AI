generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  identity String @unique
  name String
  password String?
  codingFiles CodingFile[]
  tokens Token[]
  goals Goal[]
  goalCategories GoalCategory[]
  vocabularyGroups VocabularyGroup[]
}
model Token {
  digest String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expires DateTime
}
model GoalCategory {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  name String
  key String
  createdAt DateTime @default(now())
  @@unique([userId,key])
  @@index([userId])
}
model Goal {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  domain String
  topics Topic[]
  @@index([userId])
}
model Topic {
  id String @id @default(uuid())
  goalId String
  goal Goal @relation(fields:[goalId],references:[id],onDelete:Cascade)
  title String
  notes String @default("")
  sources Source[]
  questions Question[]
  sessions StudySession[]
  outgoing Link[] @relation("src")
  incoming Link[] @relation("dst")
}
model Link {
  id String @id @default(uuid())
  src String
  dst String
  kind String
  source Topic @relation("src",fields:[src],references:[id],onDelete:Cascade)
  target Topic @relation("dst",fields:[dst],references:[id],onDelete:Cascade)
  @@unique([src,dst,kind])
}
model Source {
  id String @id @default(uuid())
  topicId String
  topic Topic @relation(fields:[topicId],references:[id],onDelete:Cascade)
  title String
  chunks String[]
  questions Question[]
  artifacts SourceArtifact[]
}
model SourceArtifact {
  id String @id @default(uuid())
  sourceId String
  source Source @relation(fields:[sourceId],references:[id],onDelete:Cascade)
  section Int
  kind String
  payload Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sourceId,section,kind])
}
model Question {
  id String @id @default(uuid())
  topicId String
  topic Topic @relation(fields:[topicId],references:[id],onDelete:Cascade)
  sourceId String?
  source Source? @relation(fields:[sourceId],references:[id])
  prompt String
  key String
  quote String @default("")
  kind String
  hint String @default("")
  rubric String @default("")
  attempts Attempt[]
  dueAt DateTime @default(now())
  days Int @default(0)
  @@index([topicId,dueAt])
}
model Attempt {
  id String @id @default(uuid())
  questionId String
  question Question @relation(fields:[questionId],references:[id])
  answer String
  confidence Int
  hint Boolean
  seconds Int
  request String @unique
  createdAt DateTime @default(now())
  rating Int?
  nextDue DateTime?
  feedback Json?
}
model StudySession {
  id String @id @default(uuid())
  topicId String
  topic Topic @relation(fields:[topicId],references:[id])
  plan Json
  evidence Json @default("[]")
  step Int @default(0)
  stepStart DateTime @default(now())
  finished Boolean @default(false)
}


model VocabularyGroup {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  nameKey String
  description String @default("")
  words VocabularyWord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, nameKey])
  @@index([userId])
}
model VocabularyWord {
  id String @id @default(uuid())
  groupId String
  group VocabularyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  word String
  wordKey String
  meaning String
  partOfSpeech String @default("other")
  pronunciation String @default("")
  example String @default("")
  exampleTranslation String @default("")
  nuance String @default("")
  days Int @default(0)
  dueAt DateTime @default(now())
  reviews VocabularyReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([groupId, wordKey])
  @@index([groupId, dueAt])
}
model VocabularyReview {
  id String @id @default(uuid())
  wordId String
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  request String @unique
  rating Int
  days Int
  dueAt DateTime
  createdAt DateTime @default(now())
  @@index([wordId, createdAt])
}

model CodingFile {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise String
  digest String @unique
  results CodingResult[]
  @@index([userId, exercise])
}
model CodingResult {
  id String @id @default(uuid())
  fileId String
  file CodingFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  runId String
  failedCases Int[] @default([])
  tutorNotes CodingTutorNote[]
  answer String
  passed Int
  total Int
  createdAt DateTime @default(now())
  @@unique([fileId, runId])
  @@index([fileId, createdAt])
}

model CodingTutorNote {
  resultId String
  result CodingResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  kind String
  content Json
  createdAt DateTime @default(now())
  @@id([resultId, kind])
}
