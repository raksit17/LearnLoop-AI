
# ==========================================
# LearnLoop-AI - Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# NestJS / Node.js build
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# Nuxt 3 / Vue
.nuxt/
.output/
.data/
.cache/
**/.nuxt/
**/.output/
**/.cache/

# Environment variables / Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.template
!**/.env.template

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / Coverage
coverage/
**/coverage/
.nyc_output/
test-results/
playwright-report/
*.lcov

# Prisma / Local Database
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# Local database backups
*.sql.gz
*.dump
*.backup

# Runtime / Temporary files
tmp/
temp/
*.tmp
*.temp
*.pid
*.seed
*.bak
*.swp
*.swo

# User uploads / generated files
uploads/
**/uploads/
storage/
**/storage/

# Docker local data
postgres_data/
redis_data/
docker-data/
.docker-data/

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# Operating System
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Package manager cache
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# Misc
*.orig
*.rej
